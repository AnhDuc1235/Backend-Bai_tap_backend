model refresh_token {
    id         Int       @id @default(autoincrement())
    user       User      @relation(fields: [user_id], references: [id])
    user_id    Int
    token      String?   @unique @db.VarChar(100)
    createdAt  DateTime? @default(now()) @db.Timestamp()
    expires_at Int?

    @@map("refresh_token")
}
